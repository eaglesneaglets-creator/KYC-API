# KYC service — environment variables (copy to .env for local use; never commit .env)

DJANGO_SETTINGS_MODULE=config.settings.staging
SECRET_KEY=
DATABASE_URL=
# healthcheck.railway.app is the host Railway's health check sends.
ALLOWED_HOSTS=kyc-service-staging.up.railway.app,healthcheck.railway.app
CSRF_TRUSTED_ORIGINS=https://kyc-service-staging.up.railway.app
# Private path for the reviewer back office. Not "admin/".
ADMIN_URL=

# Encryption of ID numbers. Comma-separated Fernet keys; the first encrypts.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KYC_FIELD_KEYS=
# Keyed hash for spotting the same ID on two accounts. NEVER change it once data exists.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
KYC_HASH_KEY=
KYC_DOCUMENT_RETENTION_DAYS=90

# Private bucket (Railway Storage Bucket variable references)
S3_BUCKET=${{Bucket.BUCKET}}
S3_ENDPOINT_URL=${{Bucket.ENDPOINT}}
S3_ACCESS_KEY_ID=${{Bucket.ACCESS_KEY_ID}}
S3_SECRET_ACCESS_KEY=${{Bucket.SECRET_ACCESS_KEY}}
S3_REGION=${{Bucket.REGION}}

# Worker (optional; without it webhooks are sent inline and not retried on a timer)
REDIS_URL=${{Redis.REDIS_URL}}
CELERY_BEAT=1
